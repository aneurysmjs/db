# Copy this file to .env and adjust as needed. .env is git-ignored.

# Connection string used by src/db.mts and src/main.mts.
# Must match the user, password, database and port in docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intro

# Database used by `pnpm test`. It is dropped and recreated on every run,
# so its name must end in _test (the setup refuses to run otherwise).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/intro_test
